# Copy to .env and fill in what you have. Every key is optional; missing ones switch that feature off.

# Claude (console.anthropic.com → API keys). Sonnet 5.5 writes, Opus 5.5 studies your voice.
ANTHROPIC_API_KEY=
# Override models if you like:
# HW_MODEL_QUICK=claude-sonnet-5-5
# HW_MODEL_DEFAULT=claude-sonnet-5-5
# HW_MODEL_COMPLEX=claude-opus-5-5

# X API (developer.x.com). The bearer token reads posts (yours, and people you learn from).
X_BEARER_TOKEN=
# OAuth 2.0 client for posting as you. Callback URL: {PUBLIC_URL}/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn app with "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn".
# Redirect URL: {PUBLIC_URL}/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_VERSION=202509

# Where the app is reachable (used for OAuth redirects).
PUBLIC_URL=http://localhost:8787
PORT=8787
HOST=127.0.0.1

# If you expose the server beyond your machine, require this token on every /api call.
HOOKWORTHY_TOKEN=

# Sunday digest emails (resend.com). Without it the server logs what it would send.
RESEND_API_KEY=
DIGEST_FROM=Hookworthy <digest@yourdomain.com>
