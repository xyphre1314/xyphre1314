    },
    {
      "name": "Capture an idea",
      "url": "./#ideas"
    },
    {
      "name": "Today",
      "url": "./#today"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
