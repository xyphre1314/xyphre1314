    {
      "name": "Creator post",
      "kind": "custom",
      "refersTo": "creator-post",
      "description": "The single bright post pinned in the feed; first line is graded live.",
      "html": "<article class=\"ds-post\"><span class=\"ds-av\">Y</span><div><div class=\"ds-hd\"><b>You</b><span>@you \u00b7 now</span><span class=\"ds-sc\">84</span></div><p class=\"ds-first\">Double your price. Signups went up 31%.</p><p class=\"ds-rest\">Customers value what costs more. <span>show more</span></p></div></article>",
      "css": ".ds-post{display:grid;grid-template-columns:40px 1fr;gap:13px;padding:18px;border-radius:18px;background:#F7F7F8;color:#111214;font-family:Figtree,system-ui,sans-serif;box-shadow:0 30px 70px -20px rgba(0,0,0,.9)}.ds-av{width:40px;height:40px;border-radius:50%;background:#111214;color:#fff;display:grid;place-items:center;font-weight:600}.ds-hd{display:flex;gap:7px;align-items:center;font-size:14.5px}.ds-hd span{color:#6B6E76}.ds-sc{margin-left:auto;padding:4px 10px;border-radius:99px;background:#111214;color:#fff!important;font:500 12.5px 'Geist Mono',monospace}.ds-first{margin:6px 0 0;font:600 20px/1.35 Figtree,sans-serif;text-decoration:underline 2px;text-underline-offset:6px}.ds-rest{margin:10px 0 0;color:#44464D;font-size:15px}.ds-rest span{color:#8B8E95}"
    },
