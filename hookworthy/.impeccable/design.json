  "components": [
    {
      "name": "Primary pill",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one light pill per view: Start free, Start with Pro, Sharpen it.",
      "html": "<a class=\"ds-btn-primary\" href=\"#\">Start free <svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path d=\"M3 8h10M9 4l4 4-4 4\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 18px;border-radius:999px;background:var(--cta,#E5E5E5);color:var(--cta-ink,#0D0D0D);font:500 15px/1 var(--font-ui,Inter,system-ui,sans-serif);letter-spacing:-.005em;text-decoration:none;transition:background .2s ease,transform .25s cubic-bezier(.22,1,.36,1)}.ds-btn-primary svg{transition:transform .3s cubic-bezier(.22,1,.36,1)}.ds-btn-primary:hover{background:var(--cta-hover,#FFFFFF)}.ds-btn-primary:hover svg{transform:translateX(2px)}.ds-btn-primary:active{transform:scale(.97)}.ds-btn-primary:focus-visible{outline:2px solid var(--text-1,#EDEDED);outline-offset:3px}"
    },
    {
      "name": "Ghost pill",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "A 7% ink tint beside the primary: See how it works.",
      "html": "<a class=\"ds-btn-ghost\" href=\"#\">See how it works</a>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;height:40px;padding:0 18px;border-radius:999px;background:color-mix(in srgb,var(--text-1,#EDEDED) 7%,transparent);color:var(--text-1,#EDEDED);font:500 15px/1 var(--font-ui,Inter,system-ui,sans-serif);text-decoration:none;transition:background .2s ease,transform .25s cubic-bezier(.22,1,.36,1)}.ds-btn-ghost:hover{background:color-mix(in srgb,var(--text-1,#EDEDED) 12%,transparent)}.ds-btn-ghost:active{transform:scale(.97)}.ds-btn-ghost:focus-visible{outline:2px solid var(--text-1,#EDEDED);outline-offset:3px}"
    },
    {
      "name": "Line pill",
      "kind": "button",
      "refersTo": "button-line",
      "description": "Transparent with a strong hairline: Free and Studio plan buttons, Copy.",
      "html": "<button class=\"ds-btn-line\" type=\"button\">Start with Studio</button>",
      "css": ".ds-btn-line{display:inline-flex;align-items:center;height:40px;padding:0 18px;border:0;border-radius:999px;background:transparent;color:var(--text-1,#EDEDED);box-shadow:inset 0 0 0 1px var(--border-strong,rgba(255,255,255,.12));font:500 15px/1 var(--font-ui,Inter,system-ui,sans-serif);cursor:pointer;transition:background .2s ease,transform .25s cubic-bezier(.22,1,.36,1)}.ds-btn-line:hover{background:color-mix(in srgb,var(--text-1,#EDEDED) 6%,transparent)}.ds-btn-line:active{transform:scale(.97)}.ds-btn-line:focus-visible{outline:2px solid var(--text-1,#EDEDED);outline-offset:3px}"
    },
    {
      "name": "App button",
      "kind": "button",
      "refersTo": "app-button",
      "description": "App controls: card grey, strong hairline, 10px corners; the primary swaps in the pill colour.",
      "html": "<span style=\"display:inline-flex;gap:8px\"><button class=\"ds-app-btn\" type=\"button\">Schedule</button><button class=\"ds-app-btn ds-app-btn-primary\" type=\"button\">Post now</button></span>",
      "css": ".ds-app-btn{height:34px;padding:0 14px;border:0;border-radius:10px;background:var(--surface,#171717);color:var(--text-1,#EDEDED);box-shadow:0 0 0 1px var(--border-strong,rgba(255,255,255,.12));font:500 14px/1 var(--font-ui,Inter,system-ui,sans-serif);cursor:pointer;transition:background 120ms cubic-bezier(.16,1,.3,1),transform 320ms cubic-bezier(.3,1.45,.4,1)}.ds-app-btn:hover{background:var(--surface-2,#1C1C1C)}.ds-app-btn:active{transform:scale(.965)}.ds-app-btn:focus-visible{box-shadow:0 0 0 1px var(--bg,#0A0A0A),0 0 0 3px var(--accent,#EDEDED);outline:0}.ds-app-btn-primary{background:var(--cta,#E5E5E5);color:var(--cta-ink,#0D0D0D);box-shadow:none}.ds-app-btn-primary:hover{background:var(--cta-hover,#FFFFFF)}"
    },
    {
      "name": "Input",
      "kind": "input",
      "refersTo": "input",
      "description": "App field: card grey, strong hairline; focus turns the hairline ink-2 with a soft 4px ring.",
      "html": "<input class=\"ds-input\" type=\"email\" placeholder=\"you@example.com\" aria-label=\"Email\">",
      "css": ".ds-input{width:280px;height:38px;padding:0 12px;border:0;border-radius:10px;background:var(--surface,#171717);color:var(--text-1,#EDEDED);box-shadow:0 0 0 1px var(--border-strong,rgba(255,255,255,.12));font:400 14px/1 var(--font-ui,Inter,system-ui,sans-serif);outline:0;transition:box-shadow 120ms cubic-bezier(.16,1,.3,1)}.ds-input::placeholder{color:var(--text-3,#8C8C8C)}.ds-input:hover{box-shadow:0 0 0 1px var(--text-3,#8C8C8C)}.ds-input:focus-visible,.ds-input:focus{box-shadow:0 0 0 1px var(--text-2,#A3A3A3),0 0 0 4px var(--accent-soft,rgba(255,255,255,.07))}"
    },
    {
      "name": "Nav capsule",
      "kind": "nav",
      "refersTo": "nav-capsule",
      "description": "The floating site nav: frosted only because it rides over scrolling content.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Site\"><b class=\"ds-nav-logo\">Hookworthy</b><a href=\"#\">How it works</a><a href=\"#\" aria-current=\"page\">Features</a><a href=\"#\">Pricing</a><span class=\"ds-nav-grow\"></span><a href=\"#\">Sign in</a><a class=\"ds-nav-cta\" href=\"#\">Start free</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:22px;max-width:760px;height:56px;padding:0 8px 0 18px;border-radius:999px;background:color-mix(in srgb,var(--surface,#171717) 72%,transparent);-webkit-backdrop-filter:blur(18px) saturate(1.5);backdrop-filter:blur(18px) saturate(1.5);box-shadow:inset 0 0 0 1px var(--border,rgba(255,255,255,.07)),0 12px 34px -22px rgba(0,0,0,.7);font:500 14.5px/1 var(--font-ui,Inter,system-ui,sans-serif)}.ds-nav-logo{font:600 17px/1 var(--font-ui,Inter,system-ui,sans-serif);letter-spacing:-.03em;color:var(--text-1,#EDEDED)}.ds-nav a{color:var(--text-2,#A3A3A3);text-decoration:none;transition:color .2s}.ds-nav a:hover,.ds-nav a[aria-current]{color:var(--text-1,#EDEDED)}.ds-nav a:focus-visible{outline:2px solid var(--text-1,#EDEDED);outline-offset:3px;border-radius:6px}.ds-nav-grow{flex:1}.ds-nav .ds-nav-cta{display:inline-flex;align-items:center;height:34px;padding:0 14px;border-radius:999px;background:var(--cta,#E5E5E5);color:var(--cta-ink,#0D0D0D);font-size:14px}.ds-nav .ds-nav-cta:hover{background:var(--cta-hover,#FFFFFF);color:var(--cta-ink,#0D0D0D)}"
    },
    {
      "name": "Pill tabs",
      "kind": "chip",
      "refersTo": "tab-track",
      "description": "A pill track with a sliding thumb: the window tabs, persona tabs, Monthly / Yearly, the theme switch.",
      "html": "<div class=\"ds-tabs\" role=\"tablist\"><span class=\"ds-tabs-thumb\" aria-hidden=\"true\"></span><button role=\"tab\" aria-selected=\"true\" type=\"button\">Write</button><button role=\"tab\" aria-selected=\"false\" type=\"button\">Week</button><button role=\"tab\" aria-selected=\"false\" type=\"button\">Review</button><button role=\"tab\" aria-selected=\"false\" type=\"button\">Results</button></div>",
      "css": ".ds-tabs{position:relative;display:inline-flex;gap:2px;padding:4px;border-radius:999px;background:var(--surface,#171717);box-shadow:inset 0 0 0 1px var(--border,rgba(255,255,255,.07))}.ds-tabs button{position:relative;z-index:1;height:36px;padding:0 16px;border:0;border-radius:999px;background:transparent;color:var(--text-2,#A3A3A3);font:500 14.5px/1 var(--font-ui,Inter,system-ui,sans-serif);cursor:pointer;transition:color .25s}.ds-tabs button:hover,.ds-tabs button[aria-selected=\"true\"]{color:var(--text-1,#EDEDED)}.ds-tabs button:focus-visible{outline:2px solid var(--text-1,#EDEDED);outline-offset:2px}.ds-tabs-thumb{position:absolute;z-index:0;top:4px;bottom:4px;left:4px;width:76px;border-radius:999px;background:var(--surface-3,#262626);box-shadow:inset 0 0 0 1px var(--border-strong,rgba(255,255,255,.12));transition:transform .5s cubic-bezier(.22,1,.36,1),width .5s cubic-bezier(.22,1,.36,1)}"
    },
    {
      "name": "Headline tile",
      "kind": "custom",
      "refersTo": "display",
      "description": "A face (or platform mark) set inside a Newsreader line as a tilted .84em tile that springs in.",
      "html": "<h1 class=\"ds-h1\">Sound like <span class=\"ds-tile\" aria-hidden=\"true\"></span> you.</h1>",
      "css": ".ds-h1{margin:0;font:400 64px/1 var(--font-serif,Newsreader,Georgia,serif);letter-spacing:-.038em;color:var(--text-1,#EDEDED)}.ds-tile{display:inline-block;width:.84em;height:.84em;margin:0 .1em 0 .12em;vertical-align:-.1em;border-radius:.22em;transform:rotate(-4deg);background:var(--surface-3,#262626);box-shadow:0 .06em .2em -.04em rgba(0,0,0,.55),inset 0 0 0 1px rgba(255,255,255,.12),inset 0 1px 0 rgba(255,255,255,.2);animation:ds-tile 1s .3s cubic-bezier(.34,1.45,.5,1) both}@keyframes ds-tile{from{opacity:0;transform:rotate(-4deg) scale(.35)}}@media (prefers-reduced-motion:reduce){.ds-tile{animation:none}}"
    },
    {
      "name": "Soft-word mark",
      "kind": "custom",
      "refersTo": "soft-word",
      "description": "The amber wavy underline under hedges and filler; the only use of amber besides badges.",
      "html": "<p class=\"ds-soft\"><span class=\"ds-sw\">so i think</span> the most underrated thing in trading is <span class=\"ds-sw\">honestly</span> <span class=\"ds-sw\">just</span> sizing down after a loss.</p>",
      "css": ".ds-soft{margin:0;max-width:34em;font:500 16.5px/1.6 var(--font-ui,Inter,system-ui,sans-serif);color:var(--text-1,#EDEDED)}.ds-sw{text-decoration:underline wavy color-mix(in srgb,var(--warn,#F5B44C) 88%,transparent);text-decoration-thickness:1.5px;text-underline-offset:4px;text-decoration-skip-ink:none;transition:text-decoration-color .5s}.ds-sw:hover{text-decoration-color:var(--warn,#F5B44C)}"
    },
    {
      "name": "Slice card",
      "kind": "card",
      "refersTo": "slice-card",
      "description": "A product slice: a sentence with a bold lead over one framed piece of UI running off the bottom; status as words and neutral dots.",
      "html": "<article class=\"ds-slice\"><p><b>Ideas from anywhere.</b> Voice notes, links and screenshots. The best ones become drafts in your voice.</p><div class=\"ds-slice-ui\"><div class=\"ds-li\"><span>Sizing down after a loss</span><span class=\"ds-st\">Drafted</span></div><div class=\"ds-li\"><span>Funding flipped negative</span><span class=\"ds-st ds-st-open\">Saved</span></div></div></article>",
      "css": ".ds-slice{display:flex;flex-direction:column;max-width:420px;padding:32px 32px 0;border-radius:24px;background:var(--surface,#171717);box-shadow:inset 0 0 0 1px var(--border,rgba(255,255,255,.07));overflow:hidden;font-family:var(--font-ui,Inter,system-ui,sans-serif)}.ds-slice p{margin:0;font-size:16.5px;line-height:1.5;color:var(--text-2,#A3A3A3)}.ds-slice b{color:var(--text-1,#EDEDED);font-weight:600}.ds-slice-ui{margin-top:26px;padding:6px 18px 18px;border-radius:16px 16px 0 0;background:color-mix(in srgb,var(--surface,#171717) 55%,var(--panel,#0D0D0D));box-shadow:inset 0 0 0 1px var(--border,rgba(255,255,255,.07))}.ds-li{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:48px;font-size:13px;color:var(--text-1,#EDEDED)}.ds-li+.ds-li{border-top:1px solid var(--border,rgba(255,255,255,.07))}.ds-st{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:500;color:var(--text-2,#A3A3A3)}.ds-st::before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor}.ds-st-open::before{background:transparent;box-shadow:inset 0 0 0 1.5px var(--text-3,#8C8C8C)}"
