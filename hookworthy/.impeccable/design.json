  "narrative": {
    "northStar": "The Thumb-Stop",
    "overview": "A feed is a machine for ignoring things. Hookworthy shows the creator's work the way their audience meets it: in a dim, moving stream where their post is the only sharp, bright object, and where a first line scoring 70+ stops the feed.",
    "keyCharacteristics": [
      "Graphite feed ground, one bright creator post",
      "The stop must be earned (score 70+)",
      "Serif headlines, sans for everything typed, mono for numbers only",
      "Product crops as illustration",
      "Hue only for meaning"
    ],
    "rules": [
      {
        "name": "The One Bright Post Rule",
