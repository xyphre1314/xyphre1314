        "value": "0 0 0 1px var(--border-strong), inset 0 1px 0 color-mix(in srgb,var(--text-1) 10%,transparent), 0 60px 140px -60px rgba(0,0,0,.9), 0 30px 60px -40px rgba(0,0,0,.6)",
        "purpose": "The app window on the homepage (dark)."
