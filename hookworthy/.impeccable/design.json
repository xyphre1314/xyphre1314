    "typographyMeta": {
      "display": {
        "displayName": "Display",
        "purpose": "The hero line only, two lines with tiles inside; min(9.7vw, 58px) on phones."
      },
      "headline-close": {
        "displayName": "Close",
        "purpose": "The closing line, \"End of the page. Start of the post.\""
      },
      "headline": {
        "displayName": "Headline",
        "purpose": "One per section; a step smaller for trust, questions and the paste box."
      },
      "headline-sm": {
        "displayName": "Headline small",
        "purpose": "Persona heads; sign-in uses the same family at its own clamps."
      },
      "page-title": {
        "displayName": "Page title",
        "purpose": "App page titles (.display)."
      },
      "title": {
        "displayName": "Title",
        "purpose": "Story step titles and plan names."
      },
      "lede": {
        "displayName": "Lede",
        "purpose": "Section ledes in ink-2, about 31rem wide."
      },
      "body": {
        "displayName": "Body",
        "purpose": "Site body copy, 1.55 leading."
      },
      "button": {
        "displayName": "Button",
        "purpose": "Site pill labels."
      },
      "ui": {
        "displayName": "UI",
        "purpose": "App controls, tabs, list rows."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Captions, small labels and status words; sentence case, never letter-spaced."
      },
      "mono": {
        "displayName": "Mono",
        "purpose": "Times, counts, URLs, keys and step numbers only; tabular figures."
      },
      "price": {
        "displayName": "Price",
        "purpose": "Plan prices; they roll over in place."
      },
      "wordmark": {
        "displayName": "Wordmark",
        "purpose": "The logo word beside the hook-h glyph."
      },
      "wordmark-giant": {
        "displayName": "Giant wordmark",
        "purpose": "The solid 12% ink wordmark at the foot of every site page."
      }
    },
    "shadows": [
