      {
        "name": "window-light",
        "value": "0 0 0 1px var(--border-strong), 0 50px 110px -60px rgba(0,0,0,.35), 0 20px 40px -30px rgba(0,0,0,.18)",
        "purpose": "The app window in the light theme."
      },
      {
        "name": "capsule",
