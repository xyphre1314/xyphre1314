      },
      {
        "name": "app-ease-out",
        "value": "cubic-bezier(.16,1,.3,1)",
        "purpose": "App state transitions."
      },
      {
        "name": "app-spring-snap",
        "value": "cubic-bezier(.3,1.45,.4,1)",
        "purpose": "App button press (scale .965) over --d-spring."
